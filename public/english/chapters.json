{
  "level": "B1-B2",
  "purpose": "Speak these lines out loud. If you would not say it today, it does not belong here.",
  "chapters": [
    {
      "id": "01",
      "title": "The Wrong Order",
      "minutes": 6,
      "scene": "South Gate Coffee, Chengdu, Monday 8:47 a.m.",
      "functions": [
        "ordering coffee",
        "apologizing",
        "small talk",
        "walking together",
        "making a simple plan"
      ],
      "story": [
        {
          "type": "narration",
          "speaker": "",
          "text": "Monday. Lin is late. The coffee shop is packed."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Hi. One oat latte to go, please."
        },
        {
          "type": "dialogue",
          "speaker": "Barista",
          "text": "Name for the order?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Lin. L-I-N."
        },
        {
          "type": "dialogue",
          "speaker": "Barista",
          "text": "Got it."
        },
        {
          "type": "narration",
          "speaker": "",
          "text": "She checks her phone. Standup is in ten minutes."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Oh no."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Long line, right?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Yeah. I usually come earlier."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Same. First week here. I keep getting the time wrong."
        },
        {
          "type": "dialogue",
          "speaker": "Barista",
          "text": "Oat latte for Lin?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Thanks."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Wait. Sorry. I think that's mine."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "This one?"
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Yeah. I ordered an oat latte too. Name's Alex."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Oh. My bad. Here you go."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "No worries. Easy mix-up."
        },
        {
          "type": "dialogue",
          "speaker": "Barista",
          "text": "And an oat latte for Alex. Two of them."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Then this one is mine."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Perfect."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Are you heading to the office too?"
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "South Gate? Third floor? Yeah. I start today."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "You're the new designer. I'm Lin. Product."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Nice to meet you, Lin."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Nice to meet you too. We can walk together, if you want."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "That'd be great. I still get lost."
        },
        {
          "type": "narration",
          "speaker": "",
          "text": "They step outside. A scooter goes by."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "How do you like Chengdu so far?"
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "I like it. It's warm. And the food is a lot."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "In a good way?"
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "In a very good way. I just don't know what to order."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "I can show you a place at lunch. If you're free."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "I'm free. I'd like that."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Cool. We should move. Standup is at nine."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "After you."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "If you need anything today, just ask."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "I will. Thanks for not stealing my coffee."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Hey. I only borrowed it."
        }
      ],
      "phrases": [
        {
          "en": "One oat latte to go, please.",
          "zh": "外带燕麦拿铁，麻烦了。"
        },
        {
          "en": "I think that's mine.",
          "zh": "这个应该是我的。"
        },
        {
          "en": "My bad. Here you go.",
          "zh": "我的错，给你。"
        },
        {
          "en": "No worries. Easy mix-up.",
          "zh": "没事，很容易拿错。"
        },
        {
          "en": "Are you heading to the office too?",
          "zh": "你也去公司吗？"
        },
        {
          "en": "We can walk together, if you want.",
          "zh": "要是你愿意，我们一起走。"
        },
        {
          "en": "That'd be great. I still get lost.",
          "zh": "太好了，我还是会迷路。"
        },
        {
          "en": "I can show you a place at lunch.",
          "zh": "中午我可以带你去一个地方。"
        },
        {
          "en": "If you're free.",
          "zh": "你要是有空的话。"
        },
        {
          "en": "If you need anything today, just ask.",
          "zh": "今天需要什么，直接问我就行。"
        }
      ],
      "role_play": [
        "You are Lin. You just picked up the wrong coffee.",
        "1. Say it is not yours and give it back.",
        "2. Check if they are going to the same office.",
        "3. Offer to walk together.",
        "4. Invite them to lunch, but keep it light.",
        "Then switch. You are Alex, first week in town.",
        "1. Apologize for the mix-up.",
        "2. Say you still get lost.",
        "3. Accept the lunch invite."
      ],
      "notes": [
        {
          "en": "to go",
          "zh": "外带。for here 才是堂食。"
        },
        {
          "en": "My bad.",
          "zh": "熟人/轻松场合认错。正式场合用 Sorry about that."
        },
        {
          "en": "I think that's mine.",
          "zh": "比 That's mine 客气，适合对陌生人。"
        },
        {
          "en": "if you want / if you're free",
          "zh": "把邀请变软，对方好拒绝。"
        },
        {
          "en": "That'd be great.",
          "zh": "答应邀请的短口块，比 Yes, I would 自然。"
        },
        {
          "en": "just ask",
          "zh": "收尾用，表示你可以来找我。"
        }
      ],
      "source": "01-the-wrong-order.md"
    },
    {
      "id": "02",
      "title": "What's Good Here",
      "minutes": 6,
      "scene": "A small lunch place near the office, Monday 12:10 p.m.",
      "functions": [
        "asking for help",
        "talking spice",
        "ordering food",
        "sharing",
        "paying"
      ],
      "story": [
        {
          "type": "narration",
          "speaker": "",
          "text": "Lunch. They sit down at a small place nearby."
        },
        {
          "type": "dialogue",
          "speaker": "Waiter",
          "text": "Two?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Yeah. This table is fine."
        },
        {
          "type": "narration",
          "speaker": "",
          "text": "The waiter puts down two menus."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "I can't read this. Can you help me?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Sure. You like spicy food?"
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "A little. Not too spicy."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Okay. No super spicy. Got it."
        },
        {
          "type": "dialogue",
          "speaker": "Waiter",
          "text": "Ready to order?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Almost. What's good here?"
        },
        {
          "type": "dialogue",
          "speaker": "Waiter",
          "text": "Mapo tofu. And the garlic pork."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Is the tofu very spicy?"
        },
        {
          "type": "dialogue",
          "speaker": "Waiter",
          "text": "Medium. We can make it mild."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Mild, please. I still want to taste it."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Let's get that. And the garlic pork."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Can we share?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Yeah. Sharing is easier."
        },
        {
          "type": "dialogue",
          "speaker": "Waiter",
          "text": "Rice?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Two bowls, please."
        },
        {
          "type": "dialogue",
          "speaker": "Waiter",
          "text": "Anything to drink?"
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Just water for me."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Same. Thanks."
        },
        {
          "type": "narration",
          "speaker": "",
          "text": "The food comes fast."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "This smells so good."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Try the tofu first. It's not too hot."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Oh. It's warm, but I like it."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "See? You can eat this."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "What's this green stuff?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Cilantro. Move it if you want."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "I'm okay. How do I say it's too spicy?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Just say \"too spicy, please.\" That's enough."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Got it. This pork is really good."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "I know, right?"
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "I might come back tomorrow."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "We can. It's close."
        },
        {
          "type": "dialogue",
          "speaker": "Waiter",
          "text": "All good?"
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Yes. Can we get the bill?"
        },
        {
          "type": "dialogue",
          "speaker": "Waiter",
          "text": "Together or separate?"
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "I can get it. You showed me the place."
        },
        {
          "type": "dialogue",
          "speaker": "Lin",
          "text": "Next time is on me."
        },
        {
          "type": "dialogue",
          "speaker": "Alex",
          "text": "Deal."
        }
      ],
      "phrases": [
        {
          "en": "I can't read this. Can you help me?",
          "zh": "这个我看不懂，能帮我吗？"
        },
        {
          "en": "A little. Not too spicy.",
          "zh": "一点点辣就行，不要太辣。"
        },
        {
          "en": "What's good here?",
          "zh": "这儿有什么好吃的？"
        },
        {
          "en": "Is it very spicy?",
          "zh": "这个很辣吗？"
        },
        {
          "en": "Can we make it mild?",
          "zh": "可以做成微辣吗？"
        },
        {
          "en": "Can we share?",
          "zh": "可以一起分着吃吗？"
        },
        {
          "en": "Just water for me.",
          "zh": "我喝水就行。"
        },
        {
          "en": "This is really good.",
          "zh": "这个真的好吃。"
        },
        {
          "en": "Can we get the bill?",
          "zh": "买单。"
        },
        {
          "en": "Together or separate?",
          "zh": "一起付还是分开付？"
        },
        {
          "en": "Next time is on me.",
          "zh": "下次我请。"
        }
      ],
      "role_play": [
        "You are Alex. You cannot read the menu.",
        "1. Ask for help.",
        "2. Say you only want a little spice.",
        "3. Ask if a dish is too spicy.",
        "4. Ask to share.",
        "Then switch. You are Lin.",
        "1. Ask what's good here.",
        "2. Order two dishes and rice.",
        "3. Ask for the bill.",
        "4. Say next time is on you."
      ],
      "notes": [
        {
          "en": "What's good here?",
          "zh": "请人推荐，比 What's your favorite 更常用。"
        },
        {
          "en": "mild",
          "zh": "微辣。not too spicy 是先把底线说清。"
        },
        {
          "en": "Can we share?",
          "zh": "两人点菜时很实用，避免各点一份太多。"
        },
        {
          "en": "Just water for me.",
          "zh": "拒饮料的短句。Same 可以接在后面。"
        },
        {
          "en": "Can we get the bill?",
          "zh": "比 Check, please 更口语。Check 也听得懂。"
        },
        {
          "en": "Together or separate?",
          "zh": "服务员常用。不会说就回 Together, please."
        },
        {
          "en": "Next time is on me.",
          "zh": "这次对方请，你记下一次。on me = 我请客。"
        }
      ],
      "source": "02-whats-good-here.md"
    }
  ]
}
